{
    "name": "web-chat",
    "version": "1.0.0",
    "private": true,
    "description": "Chat em tempo real de sala única, efêmera e anônima — sem framework no frontend.",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "dev:front": "vite",
        "dev:back": "npm --prefix backend run dev",
        "build": "vite build",
        "preview": "vite preview",
        "test": "npm run test:front && npm run test:back",
        "test:front": "node --test frontend/test/*.test.js",
        "test:back": "npm --prefix backend test",
        "load-test": "node scripts/load-test.mjs",
        "test:e2e": "node scripts/e2e.mjs",
        "test:memory": "node scripts/memory-test.mjs",
        "check:types": "tsc -p jsconfig.json",
        "check:contrast": "node scripts/check-contrast.mjs",
        "lint:js": "eslint .",
        "lint:css": "stylelint \"frontend/src/**/*.css\"",
        "lint": "npm run lint:js && npm run lint:css && npm run check:types && npm run check:contrast",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@eslint/js": "^9.13.0",
        "axe-core": "4.10.2",
        "eslint": "^9.13.0",
        "globals": "^15.11.0",
        "playwright": "1.63.0",
        "prettier": "^3.3.3",
        "stylelint": "^16.10.0",
        "stylelint-config-standard": "^36.0.1",
        "typescript": "^5.6.3",
        "vite": "^6.4.6"
    },
    "dependencies": {
        "@floating-ui/dom": "1.6.13"
    }
}
