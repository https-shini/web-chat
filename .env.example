# URL do servidor WebSocket usada pelo frontend.
# Sem esta variável o cliente cai no padrão local (ws://localhost:8080),
# então o projeto roda offline sem editar código.
VITE_SOCKET_URL=ws://localhost:8080

# Lista de origens autorizadas a abrir conexão com o servidor WebSocket,
# separadas por vírgula (ex.: https://meuchat.com,https://www.meuchat.com).
# OPCIONAL: sem esta variável, o servidor aceita conexão de qualquer origem,
# como sempre fez. Configure em produção para reduzir o risco de outros
# sites abrirem conexões com o seu backend (uso indevido de recursos).
ALLOWED_ORIGINS=
