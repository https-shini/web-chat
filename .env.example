# Copie este arquivo para `.env` NA RAIZ do repositório (ao lado deste).
# O frontend (Vite) e o backend leem o mesmo arquivo. Nunca versione o `.env`.
#
# Precedência no backend: variável já definida no ambiente do processo
# (ex.: painel da plataforma de hospedagem) > .env da raiz > backend/.env
# (aceito só por compatibilidade).

# ─── Frontend (embutida no JavaScript no momento do build) ──────────────
# Endereço do servidor WebSocket. Precisa começar com ws:// ou wss://; um
# valor inválido faz `npm run build` falhar com a explicação. Sem esta
# variável o cliente usa ws(s)://<host da página>:8080, então o projeto roda
# localmente sem configuração. Apenas variáveis com prefixo VITE_ chegam ao
# navegador — as do backend abaixo nunca são expostas.
VITE_SOCKET_URL=ws://localhost:8080

# ─── Backend ────────────────────────────────────────────────────────────
# Origens autorizadas a abrir conexão, separadas por vírgula, no formato
# esquema://host[:porta], sem caminho (ex.: https://meuchat.com,http://localhost:5173).
# Vazia: qualquer origem é aceita, e o servidor registra um aviso ao subir.
# CONFIGURE EM PRODUÇÃO. Uma entrada inválida impede o servidor de subir.
ALLOWED_ORIGINS=

# Porta HTTP/WebSocket (padrão 8080). Plataformas de hospedagem costumam
# definir esta variável sozinhas.
# PORT=8080

# Intervalo do heartbeat em ms (padrão 30000, mínimo 50). Conexões que não
# respondem ao ping até o ciclo seguinte são encerradas.
# HEARTBEAT_MS=30000

# Com NODE_ENV=production, a ausência de ALLOWED_ORIGINS é registrada como
# aviso (level "warn") em vez de informação.
# NODE_ENV=production
