# Copie este arquivo para `.env` NA RAIZ do repositório (ao lado deste).
# O frontend (Vite) e o backend leem o mesmo arquivo. Nunca versione o `.env`.
#
# Precedência no backend: variável já definida no ambiente do processo
# (ex.: painel da plataforma de hospedagem) > .env da raiz > backend/.env
# (aceito só por compatibilidade).

# ─── Frontend (embutida no JavaScript no momento do build) ──────────────
# Endereço do servidor WebSocket. Precisa começar com ws:// ou wss://; um
# valor inválido faz `npm run build` falhar com a explicação. Sem esta
# variável o cliente usa ws(s)://<host da página>:8080, então o projeto roda
# localmente sem configuração. Apenas variáveis com prefixo VITE_ chegam ao
# navegador — as do backend abaixo nunca são expostas.
VITE_SOCKET_URL=ws://localhost:8080

# ─── Backend ────────────────────────────────────────────────────────────
# Origens autorizadas a abrir conexão, separadas por vírgula, no formato
# esquema://host[:porta], sem caminho (ex.: https://meuchat.com,http://localhost:5173).
# Com a lista definida, conexões sem cabeçalho Origin também são recusadas.
# Comparação exata, sem curinga. Em produção: ver docs/DEPLOY_RENDER.md.
# Vazia: qualquer origem é aceita, e o servidor registra um aviso ao subir.
# CONFIGURE EM PRODUÇÃO. Uma entrada inválida impede o servidor de subir.
ALLOWED_ORIGINS=

# Porta HTTP/WebSocket (padrão 8080). Plataformas de hospedagem costumam
# definir esta variável sozinhas.
# PORT=8080

# Intervalo do heartbeat em ms (padrão 30000, mínimo 50). Conexões que não
# respondem ao ping até o ciclo seguinte são encerradas.
# HEARTBEAT_MS=30000

# Parâmetros operacionais (opcionais; os padrões abaixo são os valores usados
# quando a variável está ausente). Valor inválido impede o servidor de subir.
# MAX_CONNECTIONS=500           # conexões simultâneas (acima disso: 1013)
# MAX_PAYLOAD_BYTES=16384       # tamanho máximo de um quadro (mín. 8192)
# RATE_MESSAGES_CAPACITY=40     # rajada de mensagens por conexão
# RATE_MESSAGES_PER_SEC=8       # reposição do balde de mensagens
# RATE_SIGNALS_CAPACITY=40      # rajada de sinais de digitação
# RATE_SIGNALS_PER_SEC=8        # reposição do balde de sinais
# HISTORY_SIZE=1000             # mensagens guardadas em memória
# HISTORY_ON_JOIN=50            # mensagens enviadas a quem entra (≤ HISTORY_SIZE)

# Estabilidade de conexões (Fase 3).
# HEARTBEAT_MAX_MISSED=2        # pings seguidos sem resposta tolerados (1–10);
#                               # detecção de queda em 2–3 × HEARTBEAT_MS
# MAX_BUFFERED_BYTES=1048576    # fila de envio por conexão; acima disso o
#                               # cliente que parou de ler é desconectado
# LOGIN_TIMEOUT_MS=30000        # prazo para a conexão entrar na sala (código 4001)

# Recursos da Fase 4.
# Chave secreta de administrador. Quem digitar /admin <chave> no chat vira
# administrador (pode usar /clearall, /announce, /mute, /unmute, /kick).
# Vazia: administração desativada. Se definida: 16 a 200 caracteres, sem
# espaços (ex.: openssl rand -base64 24). NUNCA use prefixo VITE_ nela.
ADMIN_KEY=
# LEAVE_GRACE_MS=10000          # queda e volta dentro desta janela não gera
#                               # avisos de "saiu"/"entrou" (0 desliga)

# Monitoramento (Fase 3).
# METRICS_ENABLED=false         # true expõe GET /metrics (JSON, sem dados pessoais)
# METRICS_LOG_INTERVAL_MS=60000 # linha de log "metrics" periódica; 0 desliga

# Com NODE_ENV=production, a ausência de ALLOWED_ORIGINS é registrada como
# aviso (level "warn") em vez de informação.
# NODE_ENV=production
