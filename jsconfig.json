{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "checkJs": true,
        "allowJs": true,
        "noEmit": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "types": ["vite/client"]
    },
    "include": ["frontend/src/**/*.js"]
}
